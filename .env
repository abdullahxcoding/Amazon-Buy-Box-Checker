# --- Which offer source to use ---
# scraper  -> Playwright-based web scraper (use now)
# sp_api   -> Amazon SP-API (switch to this once you have Pricing-role access)
OFFER_SOURCE=scraper

# --- Scraper settings (only used when OFFER_SOURCE=scraper) ---
# IP rotation is handled by connecting Privado VPN at the OS level BEFORE
# running check_buybox.py — the script does not manage the VPN connection
# itself. Make sure Privado VPN is connected before each run (or leave it
# connected at all times while the hourly schedule is active).
#
# Optional safety net: set this to your normal (non-VPN) public IP. If the
# script detects it's still on this IP, it assumes the VPN is disconnected
# and aborts the run instead of scraping from your raw IP. Leave blank to
# skip this check (the current IP is still logged either way).
HOME_IP=

# Delay range (seconds) between ASIN checks, to look less bot-like
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=20
AMAZON_DOMAIN=amazon.co.uk

# --- SP-API settings (only used when OFFER_SOURCE=sp_api) ---
LWA_APP_ID=
LWA_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
ROLE_ARN=
MARKETPLACE=UK

# Amazon's own retail Seller ID/name used to confirm "Sold by Amazon".
# For SP-API this is a SellerId (marketplace-specific; leave blank and use
# identify_amazon_seller.py once SP-API is active to capture it for UK).
# For the scraper this is matched against the exact "Sold by" text shown on
# amazon.co.uk product pages — VERIFY this against a real product page
# before relying on it, wording can be "Amazon" or "Amazon.co.uk" depending
# on the listing/category.
AMAZON_SELLER_ID=
AMAZON_SELLER_NAME=Amazon

# --- Email alerting (optional; leave blank to disable email and use log-only) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
